{
  "platform": {
    "$description": "web platform values (Figma mode: Desktop).",
    "breakpoint": {
      "$description": "Viewport range for this platform (Material 3 window size classes: compact <600, medium/expanded 600-1199, large >=1200).",
      "min": {
        "$type": "dimension",
        "$value": {
          "value": 1200,
          "unit": "px"
        }
      }
    },
    "font": {
      "size": {
        "$description": "Font sizes (shared by EN and AR).",
        "display": {
          "lg": {
            "$type": "dimension",
            "$value": {
              "value": 40,
              "unit": "px"
            },
            "$description": "Rare, very large hero title. Use for onboarding splash or major report covers on web; high-emphasis screens on tablet; onboarding or hero-style screens on mobile. Not for normal pages."
          },
          "md": {
            "$type": "dimension",
            "$value": {
              "value": 32,
              "unit": "px"
            },
            "$description": "Large feature title used when Display.lg is too dominant. Web: featured report titles. Tablet: large feature screens. Mobile: important entry screens."
          }
        },
        "heading": {
          "lg": {
            "$type": "dimension",
            "$value": {
              "value": 24,
              "unit": "px"
            },
            "$description": "Default page title across web, tablet, and mobile. Use at the top of any standard page."
          },
          "md": {
            "$type": "dimension",
            "$value": {
              "value": 20,
              "unit": "px"
            },
            "$description": "Heading for a major section within a page, on web, tablet, and mobile."
          },
          "sm": {
            "$type": "dimension",
            "$value": {
              "value": 18,
              "unit": "px"
            },
            "$description": "Subsection heading nested under a section heading, on web, tablet, and mobile."
          }
        },
        "title": {
          "lg": {
            "$type": "dimension",
            "$value": {
              "value": 16,
              "unit": "px"
            },
            "$description": "Title for a card, panel, or surface — not a full page. Used on web, tablet, and mobile."
          },
          "md": {
            "$type": "dimension",
            "$value": {
              "value": 14,
              "unit": "px"
            },
            "$description": "Compact title inside a dense surface (e.g. sidebar widget on web, compact list/card on tablet and mobile)."
          }
        },
        "body": {
          "lg": {
            "$type": "dimension",
            "$value": {
              "value": 16,
              "unit": "px"
            },
            "$description": "Long-form readable text — empty-state copy, important descriptions on web; comfortable long-reading content on tablet (extra line-height); prominent readable text on mobile."
          },
          "md": {
            "$type": "dimension",
            "$value": {
              "value": 14,
              "unit": "px"
            },
            "$description": "Default paragraph or dashboard text size on web, tablet, and mobile."
          },
          "sm": {
            "$type": "dimension",
            "$value": {
              "value": 13,
              "unit": "px"
            },
            "$description": "Secondary, less prominent body copy on web, tablet, and mobile."
          }
        },
        "label": {
          "lg": {
            "$type": "dimension",
            "$value": {
              "value": 14,
              "unit": "px"
            },
            "$description": "Prominent form label or strong UI label, used on web, tablet, and mobile."
          },
          "md": {
            "$type": "dimension",
            "$value": {
              "value": 13,
              "unit": "px"
            },
            "$description": "Standard compact UI label, used on web, tablet, and mobile."
          },
          "sm": {
            "$type": "dimension",
            "$value": {
              "value": 12,
              "unit": "px"
            },
            "$description": "Smallest label size — dense metadata in tight spaces, on web, tablet, and mobile."
          }
        },
        "caption": {
          "md": {
            "$type": "dimension",
            "$value": {
              "value": 12,
              "unit": "px"
            },
            "$description": "Helper text, hints, or low-emphasis notes below an input or section. Used on web, tablet, and mobile — the smallest readable text on tablet/mobile (do not go below this on those platforms)."
          },
          "sm": {
            "$type": "dimension",
            "$value": {
              "value": 11,
              "unit": "px"
            },
            "$description": "Web only. Rare, extremely dense metadata where 12px is still too large. Use sparingly. Not used on tablet or mobile — those platforms have no value smaller than Caption.md."
          }
        },
        "action": {
          "lg": {
            "$type": "dimension",
            "$value": {
              "value": 16,
              "unit": "px"
            },
