{
  "$schema": "component-tokens/v1",
  "$description": "Text field component tokens (D-13). Every value aliases a semantic Foundations token.",
  "text-field": {
    "size": {
      "$extensions": {
        "figma": {
          "collection": "Text field / Size",
          "modes": true
        }
      },
      "sm": {
        "height": {
          "$value": "{size.control.height.sm}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.sm}"
        },
        "gap": {
          "$value": "{spacing.control.gap.sm}"
        },
        "label-gap": {
          "$value": "{spacing.sm}"
        },
        "supporting-gap": {
          "$value": "{spacing.xs}"
        },
        "icon": {
          "$value": "{size.icon.sm}"
        },
        "radius": {
          "$value": "{radius.md}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "action-box": {
          "$value": "{size.icon.lg}"
        },
        "action-inset": {
          "$value": "{spacing.xs}"
        }
      },
      "md": {
        "height": {
          "$value": "{size.control.height.md}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.md}"
        },
        "gap": {
          "$value": "{spacing.control.gap.md}"
        },
        "label-gap": {
          "$value": "{spacing.sm}"
        },
        "supporting-gap": {
          "$value": "{spacing.xs}"
        },
        "icon": {
          "$value": "{size.icon.md}"
        },
        "radius": {
          "$value": "{radius.md}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "action-box": {
          "$value": "{size.control.height.sm}"
        },
        "action-inset": {
          "$value": "{spacing.xs}"
        }
      },
      "lg": {
        "height": {
          "$value": "{size.control.height.lg}"
        },
        "padding-inline": {
          "$value": "{spacing.control.padding-inline.lg}"
        },
        "gap": {
          "$value": "{spacing.control.gap.lg}"
        },
        "label-gap": {
          "$value": "{spacing.sm}"
        },
        "supporting-gap": {
          "$value": "{spacing.xs}"
        },
        "icon": {
          "$value": "{size.icon.lg}"
        },
        "radius": {
          "$value": "{radius.md}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "action-box": {
          "$value": "{size.control.height.md}"
        },
        "action-inset": {
          "$value": "{spacing.xs}"
        }
      }
    },
    "state": {
      "$extensions": {
        "figma": {
          "collection": "Text field / State",
          "modes": true
        }
      },
      "default": {
        "background": {
          "$value": "{color.background.base.default}"
        },
        "border": {
          "$value": "{color.border.bold}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.subtlest}"
        },
        "supporting": {
          "$value": "{color.text.subtlest}"
        },
        "counter": {
          "$value": "{color.text.subtlest}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-background": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-text": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      },
      "hover": {
        "background": {
          "$value": "{color.background.base.hovered}"
        },
        "border": {
          "$value": "{color.border.bold}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.subtlest}"
        },
        "supporting": {
          "$value": "{color.text.subtlest}"
        },
        "counter": {
          "$value": "{color.text.subtlest}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-background": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-text": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      },
      "focus": {
        "background": {
          "$value": "{color.background.base.default}"
        },
        "border": {
          "$value": "{color.border.focus}"
        },
        "border-width": {
          "$value": "{border.width.focus}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.default}"
        },
        "supporting": {
          "$value": "{color.text.subtlest}"
        },
        "counter": {
          "$value": "{color.text.subtlest}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-background": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-text": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      },
      "error": {
        "background": {
          "$value": "{color.background.base.default}"
        },
        "border": {
          "$value": "{color.border.error}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.subtlest}"
        },
        "supporting": {
          "$value": "{color.text.role.error}"
        },
        "counter": {
          "$value": "{color.text.role.error}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-background": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-text": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      },
      "disabled": {
        "background": {
          "$value": "{color.background.disabled}"
        },
        "border": {
          "$value": "{color.border.disabled}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.disabled}"
        },
        "input": {
          "$value": "{color.text.disabled}"
        },
        "placeholder": {
          "$value": "{color.text.disabled}"
        },
        "icon": {
          "$value": "{color.icon.disabled}"
        },
        "supporting": {
          "$value": "{color.text.disabled}"
        },
        "counter": {
          "$value": "{color.text.disabled}"
        },
        "required": {
          "$value": "{color.text.disabled}"
        },
        "addon-background": {
          "$value": "{color.background.disabled}"
        },
        "addon-text": {
          "$value": "{color.text.disabled}"
        },
        "error-icon": {
          "$value": "{color.icon.disabled}"
        }
      },
      "read-only": {
        "background": {
          "$value": "{color.background.base.subtlest}"
        },
        "border": {
          "$value": "{color.border.default}"
        },
        "border-width": {
          "$value": "{border.width.default}"
        },
        "label": {
          "$value": "{color.text.default}"
        },
        "input": {
          "$value": "{color.text.default}"
        },
        "placeholder": {
          "$value": "{color.text.subtlest}"
        },
        "icon": {
          "$value": "{color.icon.subtlest}"
        },
        "supporting": {
          "$value": "{color.text.subtlest}"
        },
        "counter": {
          "$value": "{color.text.subtlest}"
        },
        "required": {
          "$value": "{color.text.role.error}"
        },
        "addon-background": {
          "$value": "{color.background.neutral.default}"
        },
        "addon-text": {
          "$value": "{color.text.subtle}"
        },
        "error-icon": {
          "$value": "{color.icon.role.error}"
        }
      }
    }
  }
}
